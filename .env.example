OPENAI_API_KEY=
# Optional (D34): inside the web app the agent's browser has no window and is only seen in the live panel.
# Set this to get the separate Chromium window back.
# SHOW_BROWSER_WINDOW=1
# CLI scripts open a window; set this to run them headless but streamed to the app's live panel.
# IN_APP_BROWSER=1
# Optional: turn the in-app live view off.
# LIVEVIEW=0
