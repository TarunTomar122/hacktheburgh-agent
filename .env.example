OPENAI_API_KEY=
# Optional: give up on a stuck model call after this many ms (defaults: 90000 for writing/reading calls, 20000 per Decisions API try).
# OPENAI_TIMEOUT_MS=
# DECISION_TIMEOUT_MS=
# Optional (D34): inside the web app the agent's browser has no window and is only seen in the live panel.
# Set this to get the separate Chromium window back.
# SHOW_BROWSER_WINDOW=1
# CLI scripts open a window; set this to run them headless but streamed to the app's live panel.
# IN_APP_BROWSER=1
# Optional: turn the in-app live view off.
# LIVEVIEW=0

# Optional search APIs (first one set wins; falls back to the browser): finding pages is not a browser job and never hits a bot check
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Accounts (D74): sign-up and log-in with Auth0. Real values go in .env.local, never in this file.
# With none of these set the app runs without accounts, as before. AUTH_DISABLED=1 switches accounts off even when they are set.
# AUTH0_DOMAIN: your tenant's hostname only, with no https:// and no port (for example your-tenant.eu.auth0.com).
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SECRET: 64 hex characters that encrypt the session cookie. Make one with: openssl rand -hex 32
# AUTH0_SECRET=
# Optional. The address people use (http://localhost:3000). Left out, the SDK uses the address each request came to.
# APP_BASE_URL=
# AUTH_DISABLED=1
# Test only (D78): DEV_LOGIN=1 adds a "Dev: skip login" link to /welcome that signs you in as a fake user, with no Auth0 round trip.
# Ignored in production builds. Never set it on a server other people can reach (a public tunnel to `npm run dev`).
# DEV_LOGIN=1
# DEV_LOGIN_EMAIL=you@example.com


# Saved cases (D75): Postgres, for example a Tiger Data (Tiger Cloud) service. With a user signed in, their case is saved here and follows them
# to any device. Left out, the case stays in the browser only. Needs accounts (Auth0) on. The table is created on first use.
# DATABASE_URL: the service's connection string (postgres://...?sslmode=require). Put the real one in .env.local, never in this file.
# DATABASE_URL=
# Only if the connection fails with a certificate error: keeps the connection encrypted but skips checking the server's identity.
# DATABASE_SSL_NO_VERIFY=1
